# Copy to .env.local for local work. Never commit real values.
# On Vercel, add these under Project → Settings → Environment Variables.

# Stripe (use test keys, sk_test_… / pk_test_…, until you go live)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Stripe → Developers → Webhooks → your destination → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Your public site address, no trailing slash (used for Stripe return links)
SITE_URL=https://neon-needle.vercel.app
